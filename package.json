{
  "name": "agenticAiApplication",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "ingest": "tsx --env-file=.env.local scripts/ingest-pdf.ts",
    "ingest:ocr": "tsx --env-file=.env.local scripts/ingest-pdf.ts --ocr-only",
    "create-admin": "tsx --env-file=.env.local scripts/create-admin.ts",
    "ingest:crop": "npm run ingest -- --crop",
    "ingest:file": "npm run ingest -- --file",
    "lexicon": "tsx --env-file=.env.local scripts/build-telugu-lexicon.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.68",
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/openai": "^4.0.80",
    "@ai-sdk/openai-compatible": "^3.0.59",
    "@ai-sdk/react": "^4.0.110",
    "@hookform/resolvers": "^5.9.1",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.107",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "mammoth": "^1.13.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.89.0",
    "shadcn": "^4.21.1",
    "streamdown": "^2.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.4",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
